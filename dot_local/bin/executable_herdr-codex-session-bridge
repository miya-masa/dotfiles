#!/usr/bin/env python3
"""Forward a Codex prompt event to Herdr's Codex session hook.

Codex 0.147 can provide a transcript path on UserPromptSubmit even when the
initial SessionStart event has no path.  Herdr's generated hook deliberately
requires that path, so this helper supplies the later event using the same
SessionStart shape without changing the generated hook or its environment.
"""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))


def main() -> int:
    try:
        event = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError, TypeError):
        return 0

    if not isinstance(event, dict):
        return 0
    if event.get("hook_event_name") != "UserPromptSubmit":
        return 0

    session_id = event.get("session_id")
    transcript_path = event.get("transcript_path")
    if not isinstance(session_id, str) or not session_id.strip():
        return 0
    if not isinstance(transcript_path, str) or not transcript_path.strip():
        return 0

    transformed = dict(event)
    transformed["hook_event_name"] = "SessionStart"

    hook = codex_home() / "herdr-agent-state.sh"
    if not hook.is_file():
        return 0

    try:
        completed = subprocess.run(
            ["bash", str(hook), "session"],
            input=json.dumps(transformed, ensure_ascii=False),
            text=True,
            env=os.environ.copy(),
            check=False,
        )
    except OSError:
        return 0
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
