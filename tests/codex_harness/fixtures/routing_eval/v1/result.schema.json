{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "tier", "cardinality", "lenses", "failure_route", "verdict", "detected_defect_ids", "active_ac_status", "approval_gate", "evidence_gate", "dispatches"],
  "properties": {
    "route": {"enum": ["DIRECT", "OPTIONAL_DELEGATION", "MANDATORY_SPECIALIST"]},
    "tier": {"enum": ["minor", "normal", "high", "independent-risk"]},
    "cardinality": {"type": "integer", "minimum": 0, "maximum": 2},
    "lenses": {"type": "array", "items": {"enum": ["Completeness", "Correctness", "Robustness", "Security", "Contract", "Product-fit", "Simplicity", "Spec compliance", "Feasibility"]}},
    "failure_route": {"enum": ["controller_self_check", "stop_or_narrow_redispatch", "reclassify_then_direct"]},
    "verdict": {"enum": ["APPROVED", "BLOCKED"]},
    "detected_defect_ids": {"type": "array", "items": {"type": "string"}},
    "active_ac_status": {"type": "array", "minItems": 1, "items": {"enum": ["AC8:pass", "AC8:fail"]}},
    "approval_gate": {"enum": ["satisfied", "failed"]},
    "evidence_gate": {"enum": ["satisfied", "failed"]},
    "dispatches": {"type": "array", "items": {"type": "string"}}
  }
}
